{
  "name": "missapp-desktop",
  "productName": "MissApp GitHub Cloner",
  "version": "1.0.0",
  "description": "MissApp0-only GitHub repository cloner desktop app.",
  "main": "main.js",
  "author": "MissApp0",
  "license": "MIT",
  "homepage": "https://github.com/MissApp0",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.missapp.githubcloner",
    "productName": "MissApp GitHub Cloner",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "cloner.html",
      "cloner.css",
      "cloner.js",
      "updater.js",
      "package.json",
      "call.html"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "MissApp0",
      "repo": "MissApp-Electron",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MissApp-GitHub-Cloner-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "portable": {
      "artifactName": "MissApp-GitHub-Cloner-Portable-${version}.${ext}"
    }
  }
}
