{
  "name": "missapp-desktop",
  "productName": "MissApp",
  "version": "1.0.0",
  "description": "MissApp desktop client for Windows, macOS and Linux.",
  "main": "main.js",
  "author": "MissApp0",
  "license": "MIT",
  "homepage": "https://missapp0.github.io",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.missapp.desktop",
    "productName": "MissApp",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "MissApp0",
      "repo": "MissApp-Electron",
      "releaseType": "release"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "MissApp-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.social-networking"
    }
  }
}